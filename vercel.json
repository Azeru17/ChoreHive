{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/(?:config(?:\\.local(?:\\.example)?)?|layout|footer|worker_data|paymongo|_check|_run_migration)\\.php$",
      "status": 404
    },
    {
      "src": "^/(?:api|lib|uploads|\\.git)(?:/.*)?$",
      "status": 404
    },
    {
      "src": "^/$",
      "dest": "/api/index.php?__chorehive_path=index.php"
    },
    {
      "src": "^/(.*\\.php)$",
      "dest": "/api/index.php?__chorehive_path=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
